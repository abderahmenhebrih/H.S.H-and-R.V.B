# Backend environment variables
# Copy this file to .env and fill in real values (never commit .env)

# Server port — frontend expects NEXT_PUBLIC_API_URL to point here
PORT=5000

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hebrih-slaughter-house

# CORS — allowed frontend origins (comma-separated for multiple)
# Development: H.S.H/R.V.B Web (3000) + Expo Web (8081)
# Example: CORS_ORIGIN=http://localhost:3000,http://localhost:8081
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# RVB Auth — JWT secrets (required in production, optional in test where defaults are used)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
RVB_JWT_ACCESS_SECRET=change-this-access-secret-at-least-32-chars
RVB_JWT_REFRESH_SECRET=change-this-refresh-secret-at-least-32-chars
# Optional TTLs (defaults: 15m and 30d)
RVB_ACCESS_TOKEN_TTL=15m
RVB_REFRESH_TOKEN_TTL=30d

# Optional DNS override for MongoDB SRV (comma-separated IPs)
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Server mode: full (H.S.H + R.V.B) or rvb-public (R.V.B only, no /api/sync,/api/printing,/api/invoices)
SERVER_MODE=full
# For public/mobile deployment, use rvb-public and set ALLOW_FULL_SERVER_IN_PRODUCTION=true only if you intentionally expose full mode in production
# ALLOW_FULL_SERVER_IN_PRODUCTION=true
# Trust proxy (for rate limiting / IP forwarding behind reverse proxy) - 0 = disabled, 1 = trust first proxy, or number
TRUST_PROXY=0

# Node environment
NODE_ENV=development
