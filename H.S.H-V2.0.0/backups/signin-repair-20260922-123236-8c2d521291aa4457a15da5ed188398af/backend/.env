# Backend environment variables
# Copy this file to .env and fill in real values (never commit .env)

# Server port — frontend expects NEXT_PUBLIC_API_URL to point here
PORT=5000

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://abderahmen:abderahmen123@cluster0.omxs0ia.mongodb.net/hebrih-slaughter-house
# CORS — allowed frontend origin (comma-separated for multiple)
# Development default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# RVB Auth — JWT secrets (required in production, optional in test where defaults are used)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
RVB_JWT_ACCESS_SECRET="d00e8ae70728c349c37e583fab1e79ab1eac877a84adb14bcf6c0dbd584b491e3103d7cd582db03b31ac73ee356d2facb77f5ebcc868b6b4e7e4a4877a110ed5"
RVB_JWT_REFRESH_SECRET="689113dad2163a0934cfe148c85be284e91453c4327d7127bf76cbe54c46b0db92a1c788ffa1879fc4304bac2056678948d0f812dc31ddc35bc11e59594e649e"
# Optional TTLs (defaults: 15m and 30d)
RVB_ACCESS_TOKEN_TTL=15m
RVB_REFRESH_TOKEN_TTL=30d

# Node environment
NODE_ENV=development
