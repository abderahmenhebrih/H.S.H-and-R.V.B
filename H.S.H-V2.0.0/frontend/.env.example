# Frontend environment variables
# Copy this file to .env.local and fill in real values (never commit .env.local)

# Backend API URL — used by the sync client and any future API calls
# Development default matches the backend dev port (see backend/.env.example)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Frontend deployment mode: full (H.S.H + R.V.B) or rvb-public (R.V.B only, blocks H.S.H routes via proxy.ts)
# - full: normal combined workspace (trusted/local)
# - rvb-public: public R.V.B web deployment — only /rvb/** allowed, H.S.H routes (/customers, /workers, /suppliers, /accounts, /settings, /dashboard etc.) redirect to /rvb
# Pair with backend SERVER_MODE=rvb-public for public/mobile deployment; use full/full for local/LAN.
FRONTEND_MODE=full
# Alternative public alias supported in proxy: NEXT_PUBLIC_FRONTEND_MODE=rvb-public (if using Next public env), but prefer FRONTEND_MODE.
