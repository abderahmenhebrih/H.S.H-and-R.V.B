# R.V.B Mobile environment variables
# Copy to .env and set your LAN/backend URL. Never commit .env.

# Example LAN development: http://192.168.1.100:5000
# Example local emulator: http://10.0.2.2:5000 (Android emulator) or http://localhost:5000 (web only)
EXPO_PUBLIC_RVB_API_URL=http://192.168.1.100:5000
